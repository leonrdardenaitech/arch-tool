{
    "manifest_version": 3,
    "name": "Darden Array Copilot",
    "version": "1.0",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["http://localhost:11434/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Auto-Fill Application"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}
